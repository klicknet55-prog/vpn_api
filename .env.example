# Salin file ini menjadi .env lalu isi nilai yang sesuai
# cp .env.example .env

# Kredensial Basic Auth untuk mengakses API
API_USERNAME=admin
API_PASSWORD=ganti_password_kuat_disini

# Domain induk untuk membuat subdomain proxy, contoh: app.example.com dari label "app"
PROXY_BASE_DOMAIN=example.com

# Email untuk registrasi sertifikat Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# Opsional: auto create/delete A record via BIND9 nsupdate
BIND9_AUTO_A_RECORD=false
BIND9_ZONE=example.com
BIND9_SERVER=127.0.0.1
BIND9_KEY_PATH=/etc/bind/keys/vpn-api.key
BIND9_A_TARGET_IP=203.0.113.10
BIND9_TTL=300
